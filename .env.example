# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase → Project Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=

# BotFather → /newbot → токен
TELEGRAM_BOT_TOKEN=
# Юзернейм бота без @ (напр. BarcaRatingsBot) — публічний, для кнопки логіну
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Будь-який довгий випадковий рядок — захищає /api/telegram/webhook від чужих запитів
# (той самий рядок передається в setWebhook як secret_token, див. README)
TELEGRAM_WEBHOOK_SECRET=

# Будь-який довгий випадковий рядок — секрет для /api/admin/tick (резервний cron)
CRON_SECRET=

# Публічна адреса сайту (без слешу в кінці) — бот надсилає посилання назад на неї
SITE_URL=
